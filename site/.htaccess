# FertilityList — LiteSpeed/Apache config (static Astro build)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://fertilitylist.com%{REQUEST_URI} [L,R=301]

  # Canonical host: no www
  RewriteCond %{HTTP_HOST} ^www\.fertilitylist\.com$ [NC]
  RewriteRule ^ https://fertilitylist.com%{REQUEST_URI} [L,R=301]

  # Keep cPanel shortcuts working
  RewriteRule ^(cpanel|webmail|whm)(/.*)?$ - [L]

  # Add trailing slash to directory-style URLs (no file extension)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://fertilitylist.com/$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Hashed build assets never change
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json|csv)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType text/csv .csv
  AddType text/plain .txt
  AddCharset utf-8 .html .css .js .xml .txt .json .csv
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/csv application/javascript application/json application/xml image/svg+xml
</IfModule>
